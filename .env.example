# ---------------------------------------------------------------------------
# IGDB — base de jeux. Gratuit. Deja valide (13 surs / 15 sur le spike).
# https://dev.twitch.tv/console/apps
# ---------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Source des comparables : ebay | vinted | mock
#
#   ebay   -> officiel, marche depuis Vercel. Compte en attente d'approbation.
#   vinted -> le vrai marche cible, MAIS hors CGU et IP residentielle obligatoire.
#             Ne fonctionne qu'en `npm run dev` sur ta machine. Jamais deploye.
#   mock   -> annonces simulees, pour developper l'UI sans reseau.
#
# Vide = eBay si les cles sont la, sinon mock. L'UI affiche toujours d'ou
# viennent les chiffres.
# ---------------------------------------------------------------------------
VGPC_SOURCE=mock

# https://developer.ebay.com/my/keys — cle de PRODUCTION (le Sandbox est vide)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

VINTED_HOST=www.vinted.fr

# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard  (projet > Settings > API)
# Joue d'abord supabase/schema.sql dans l'editeur SQL du projet.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Vision (lecture des tranches de boite) — https://console.anthropic.com
# Cote serveur uniquement : ne prefixe JAMAIS cette cle par NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
